# Loaded by `vite --mode emulator` (npm run dev:emulator).
#
# Vite's precedence is .env.[mode] over .env, which is the point: .env carries
# the real credentials for legwan-82a09, the live shop database, and passing
# overrides on the command line does not beat it. Without this file the test
# suite connected to the emulator under the production project id, so writes
# landed in a namespace the assertions never looked at and every check reported
# "nothing was saved".
#
# Nothing here is secret. The `demo-` prefix is meaningful to Firebase: the SDKs
# treat such a project as emulator-only and refuse to contact production for it,
# so a misconfiguration fails loudly instead of quietly writing to real data.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_PROJECT_ID=demo-legwan
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-legwan.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-legwan.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
